# Konfigurasi Stockify (frontend + backend + database).
#
# Salin file ini menjadi .env di root proyek lalu isi dengan nilai sesuai
# mesin kamu:
#   Copy-Item .env.example .env
#
# File .env sudah masuk .gitignore dan TIDAK boleh di-commit ke GitHub.
# Docker Compose membaca file .env ini secara otomatis.
#
# Catatan:
# - File .env di ROOT dipakai oleh Docker Compose (semua service).
# - Untuk menjalankan backend di luar Docker, salin juga ke backend\.env
#   (backend/main.py membacanya lewat load_dotenv).

# --- Database PostgreSQL ---
# POSTGRES_HOST & POSTGRES_PORT dipakai backend saat berjalan di luar Docker.
# Saat memakai Docker Compose, backend otomatis diberi POSTGRES_HOST=db
# dan POSTGRES_PORT=5432 (nama service di dalam jaringan Docker).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockify
POSTGRES_USER=stockify
POSTGRES_PASSWORD=ganti_dengan_password_kamu

# --- Port yang dipublish ke host oleh Docker Compose ---
# Frontend (Nginx / UI Stockify) : http://localhost:8080
FRONTEND_PORT=8080
# Backend (FastAPI + /docs)      : http://localhost:8000/docs
BACKEND_PORT=8000
# PostgreSQL (opsional, untuk akses psql dari host) : localhost:5433
DB_HOST_PORT=5433

# --- Alternatif: satu baris URL untuk backend ---
# Didukung backend/main.py dan dipakai otomatis bila ada.
# HINDARI karakter khusus seperti @ : / # pada password, atau encode URL.
# DATABASE_URL=postgresql://stockify:ganti_dengan_password_kamu@localhost:5432/stockify

# --- Opsional: lain-lain ---
# POSTGRES_CONNECT_TIMEOUT=5
# LOG_LEVEL=info
